{
  "name": "opencode-sessions",
  "version": "0.3.1",
  "description": "OpenCode V2 plugin: any session can start, prompt, watch, read and search your other sessions, and hear back when they finish",
  "type": "module",
  "packageManager": "bun@1.4.4",
  "license": "MIT",
  "author": "igorovh",
  "homepage": "https://github.com/igorovh/opencode-sessions#readme",
  "bugs": {
    "url": "https://github.com/igorovh/opencode-sessions/issues"
  },
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/igorovh/opencode-sessions.git"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "opencode-v2",
    "sessions",
    "multi-agent",
    "orchestration",
    "tui"
  ],
  "files": [
    "src",
    "dist",
    "index.ts",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./tui": "./dist/tui.js"
  },
  "scripts": {
    "compile": "bun script/compile.ts",
    "check:dist": "bun script/check-dist.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test"
  },
  "dependencies": {
    "@opencode/client": "^2.3.0"
  },
  "peerDependencies": {
    "@opencode/plugin": ">=2.2.5",
    "@opentui/core": ">=0.8.0",
    "@opentui/solid": ">=0.8.0",
    "solid-js": ">=1.9.0"
  },
  "peerDependenciesMeta": {
    "@opencode/plugin": {
      "optional": true
    },
    "@opentui/core": {
      "optional": true
    },
    "@opentui/solid": {
      "optional": true
    },
    "solid-js": {
      "optional": true
    }
  },
  "devDependencies": {
    "@opencode/plugin": "2.3.0",
    "@opentui/core": "0.8.4",
    "@opentui/solid": "0.8.4",
    "@types/bun": "1.4.4",
    "solid-js": "1.9.19",
    "typescript": "7.0.2"
  }
}
